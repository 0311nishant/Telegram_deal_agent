# ─────────────────────────────────────────
# TELEGRAM CREDENTIALS
# Get from: https://my.telegram.org → API Development Tools
# ─────────────────────────────────────────
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_PHONE=+91XXXXXXXXXX

# ─────────────────────────────────────────
# OPENROUTER API KEY
# Get from: https://openrouter.ai/keys
# ─────────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_key_here

# ─────────────────────────────────────────
# PERPLEXITY API KEY
# Get from: https://www.perplexity.ai/settings/api
# ─────────────────────────────────────────
PERPLEXITY_API_KEY=your_perplexity_key_here

# ─────────────────────────────────────────
# ALERT SETTINGS
# Your second Telegram account username to receive hot lead alerts
# ─────────────────────────────────────────
ALERT_TELEGRAM_USERNAME=your_second_account_username

# ─────────────────────────────────────────
# SCHEDULE TIMES (24hr format, server timezone)
# ─────────────────────────────────────────
MORNING_BROADCAST_TIME=09:00
EVENING_BROADCAST_TIME=18:00
DISCOVERY_TIME=06:00